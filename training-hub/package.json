{
  "name": "training-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/prisma-generate.cjs && NODE_ENV=production next build",
    "start": "NODE_ENV=production next start --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma-generate.cjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "^15.5.23",
    "prisma": "6.19.3",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "vitest": "^4.1.11"
  }
}
